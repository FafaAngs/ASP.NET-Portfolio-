@{
    ViewData["Title"] = "Project Experience";
}

<section class="pagestitlecontainer spad set-bg" data-setbg="/images/headergreen.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="pagestitletext">
                    <h1>Project Experience</h1>
                    <div class="pagestitlebutton">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <span>Projects</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="projects-section spad">
    <div class="container">
        <div class="projects-intro text-center">
            <p>Selected academic, full-stack, mobile, and game-development work.</p>
        </div>
        <div class="project-grid">
            <article class="project-card">
                <h2>EcoShield</h2>
                <p class="project-context">CTU – Consolacion Campus</p>
                <p>A full-stack disaster resilience and climate awareness platform with an admin dashboard, SMS class-suspension notices, and real-time weather and earthquake updates.</p>
                <ul class="project-tags"><li>Full-stack</li><li>Disaster alerts</li><li>Admin dashboard</li></ul>
            </article>

            <article class="project-card">
                <h2>School Library User Logging System</h2>
                <p class="project-context">CTU – Danao and Consolacion Campuses</p>
                <p>A PHP-based library visitor logging system that lets staff and students record real-time time-in and time-out visits.</p>
                <ul class="project-tags"><li>PHP</li><li>Database</li><li>Campus system</li></ul>
            </article>

            <article class="project-card">
                <h2>Unity MMORPG Game</h2>
                <p class="project-context">Personal project · In development</p>
                <p>A multiplayer RPG game in Unity featuring core gameplay mechanics, player movement, combat, and networked interactions.</p>
                <ul class="project-tags"><li>Unity</li><li>C#</li><li>Multiplayer</li></ul>
            </article>

            <article class="project-card">
                <h2>E-Commerce Website</h2>
                <p class="project-context">Full-stack project</p>
                <p>An e-commerce application with product listings, user accounts, shopping cart, order management, an admin dashboard, backend APIs, and database integration.</p>
                <ul class="project-tags"><li>Full-stack</li><li>APIs</li><li>Database</li></ul>
            </article>

            <article class="project-card">
                <h2>Class Scheduler &amp; Finance Mobile App</h2>
                <p class="project-context">Personal project</p>
                <p>A mobile app that helps students manage class schedules, track expenses, and monitor their personal budget.</p>
                <ul class="project-tags"><li>Expo</li><li>React Native</li><li>Mobile</li></ul>
            </article>

            <article class="project-card">
                <h2>QR-Based Attendance System</h2>
                <p class="project-context">Desktop application</p>
                <p>A Java Swing application for QR-based attendance tracking, designed to record attendance through a simple desktop interface.</p>
                <ul class="project-tags"><li>Java</li><li>Java Swing</li><li>QR attendance</li></ul>
            </article>
        </div>
    </div>
</section>
