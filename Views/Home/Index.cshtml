@{
    Layout = "_Layout";
      
    ViewData["Title"] = "Home";
    
}

<section class="hero">
    <div class="visualSlider owl-carousel">
        <div class="visual set-bg" data-setbg="@Url.Content("~/images/home/gamedevpic.png")">
            <div class="container">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="visualslidertext gamedev">
                            <h2>Game Development</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="visual set-bg" data-setbg="@Url.Content("~/images/home/appdevpic.png")">
            <div class="container">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="visualslidertext ">
                            <h2>Application Development</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="visual set-bg" data-setbg="@Url.Content("~/images/home/webdevpic.jpg")">
            <div class="container">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="visualslidertext ">
                            <h2>Website Development</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="homespad">
    <div class="services">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 gif">
                    <img src="@Url.Content("~/images/home/code.gif")" alt="GIF animation" class="gif-image" />
                    <img src="@Url.Content("~/images/home/typing.png")" class="homepic" loading="lazy" />
                </div>

                <div class="col-lg-8">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-6">
                            <div class="services__item">
                                <div class="homeservicesicon">
                                    <img src="@Url.Content("~/images/progPic/app-development.png")" alt="App Development" />
                                </div>
                                <h4>Back-End Development</h4>
                                <p>I offer robust back-end solutions for dynamic websites and web applications. From setting up databases to server management, I work with Node.js, Python, and PHP to create powerful and scalable back-end systems.</p>
                            </div>
                        </div>

                        <div class="col-lg-6 col-md-6 col-sm-6">
                            <div class="services__item">
                                <div class="homeservicesicon">
                                    <img src="@Url.Content("~/images/progPic/html.png")" alt="HTML Development" />
                                </div>
                                <h4>Web Development</h4>
                                <p>I build fast, responsive websites with a focus on user experience. Whether you need a personal website, a business site, or a blog, I provide end-to-end development services, including front-end and back-end development.</p>
                            </div>
                        </div>

                        <div class="col-lg-6 col-md-6 col-sm-6">
                            <div class="services__item">
                                <div class="homeservicesicon">
                                    <img src="@Url.Content("~/images/progPic/system-development.png")" alt="System Development" />
                                </div>
                                <h4>Front-End Development</h4>
                                <p>I specialize in creating visually appealing and interactive front-end experiences. Using HTML, CSS, JavaScript, and modern frameworks like React, I bring your designs to life with smooth, functional interfaces.</p>
                            </div>
                        </div>

                        <div class="col-lg-6 col-md-6 col-sm-6">
                            <div class="services__item">
                                <div class="homeservicesicon">
                                    <img src="@Url.Content("~/images/progPic/game-development.png")" alt="Game Development" />
                                </div>
                                <h4>Game Development</h4>
                                <p>I create immersive 2D and 3D games for mobile and desktop platforms. From concept to completion, I handle all aspects of game development, including game mechanics, animation, and deployment.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="boxcontainer spad">
    <div class="container">
        <div class="row">
            <div class="quotesSlider owl-carousel">
                <div class="col-lg-4">
                    <div class="quotesbox boxitem">
                        <h4>"Coding like poetry, it must be short and clear."</h4>
                        <ul><li>– Santosh Kalwar</li></ul>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="quotesbox boxitem">
                        <h4>"It’s not a bug; it’s an undocumented feature"</h4>
                        <ul><li>― Anonymous</li></ul>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="quotesbox boxitem">
                        <h4>"First, solve the problem. Then, write the code"</h4>
                        <ul><li>– John Johnson</li></ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="spad set-bg" data-setbg="@Url.Content("~/images/progPic/taglinebanner.PNG")">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="textfooterhome">
                    <h2>Be somebody nobody thought you could be.</h2>
                </div>
            </div>
        </div>
    </div>
</section>
