
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A browser-based 2048 game by Angilbert Angcon." />
    <title>2048 | Angilbert Angcon</title>
    <link rel="stylesheet" href="~/css/gamecss.css" />
</head>
<body class="game-page">
    <main class="game-shell">
        <a class="back-link" asp-controller="Home" asp-action="Index">← Back to portfolio</a>
        <div class="game-header">
            <div>
                <p class="eyebrow">A small browser game</p>
                <h1>2048</h1>
                <p>Use the arrow keys, swipe, or the buttons to combine matching tiles.</p>
            </div>
            <div class="score-panel" aria-live="polite"><span>Score</span><strong id="score">0</strong></div>
        </div>

        <div id="game-message" class="game-message" role="status" aria-live="polite"></div>
        <div id="board" class="board" role="grid" aria-label="2048 game board"></div>

        <div class="game-actions">
            <button id="restart-button" type="button">New game</button>
        </div>
        <div class="game-controls" aria-label="Game controls">
            <button type="button" data-direction="up" aria-label="Move up">↑</button>
            <button type="button" data-direction="left" aria-label="Move left">←</button>
            <button type="button" data-direction="down" aria-label="Move down">↓</button>
            <button type="button" data-direction="right" aria-label="Move right">→</button>
        </div>
    </main>

    <script src="~/js/logic.js"></script>
</body>
</html>
