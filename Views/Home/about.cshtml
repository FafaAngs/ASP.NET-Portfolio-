@{
    Layout = "_Layout"; 
}

<div class="pagestitlecontainer spad set-bg" data-setbg="/images/headergreen.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="pagestitletext">
                    <h2>About Me</h2>
                    <div class="pagestitlebutton">
                        <a href="/Home/Index">Home</a>
                        <span>About</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="spad">
    <div class="about">
        <div class="container">
            <div class="row">

                <div class="col-lg-6">
                    <div class="aboutmepic">
                        <div class="myprofilepic set-bg" data-setbg="/images/cert/memine.jpg"></div>

                        <div class="col-lg-2">
                            <div class="discord-logo">
                                <div class="logo-with-text">
                                    <img src="/images/progPic/discord.png" alt="Discord Logo" class="img-fluid">
                                    <span class="logo-text">Discord@example</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-2">
                            <div class="email-logo">
                                <div class="logo-with-text">
                                    <img src="/images/progPic/emaill.png" alt="Email Logo" class="img-fluid">
                                    <span class="logo-text">Angilbert@example.com</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-2">
                            <div class="facebook-logo">
                                <div class="logo-with-text">
                                    <img src="/images/progPic/facebook.png" alt="Facebook Logo" class="img-fluid">
                                    <span class="logo-text">Angilbert Angcon</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="aboutmetext">
                        <h2>👋 Hi, I'm <b><i>Angilbert Angcon</i></b></h2>
                        <p>
                            I'm a <strong class="highlight">
                                <span class="mytitle">Software Developer</span>
                            </strong> with a passion for creating amazing digital experiences. Whether it's building <span class="highlight">games</span> (both <span class="highlight">2D</span> and <span class="highlight">3D</span>), developing <span class="highlight">websites</span>, or crafting <span class="highlight">apps</span>, I have the skills to bring ideas to life. I'm proficient in several programming languages including <span class="highlight">Java</span>, <span class="highlight">C#</span>, and many others, allowing me to tackle a wide range of challenges with code.
                        </p>

                        <p> For game development, I specialize in creating engaging and interactive experiences. Whether it’s building a <span class="highlight">2D platformer</span> or a complex <span class="highlight">3D world</span>, I bring them to life using powerful game engines like <span class="highlight">Unity 3D</span> and <span class="highlight">Unreal Engine</span>. These tools help me create games that are both fun and visually stunning.</p>

                        <p> I also build websites that are not only functional but also visually appealing. From simple landing pages to full-featured platforms, I focus on delivering smooth, user-friendly experiences that help businesses and individuals establish their online presence.</p>

                        <p>I'm always eager to learn and improve, continuously exploring new technologies to better serve my clients and the world of technology. Let’s collaborate and create something amazing together! 🚀</p>

                        <div class="col-lg-12">
                            <div class="unity-logo">
                                <img src="/images/progPic/unity.jpg" alt="Unity Logo">
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<div class="center-container">
    <img src="/images/progPic/2048gif.gif" alt="Game GIF" class="gif-image">
    <a href="/Home/game" target="" class="stylish-link">
        PLAY my game
    </a>
    <br>
    <br>
    <a href="https://angcon.likesyou.org" target="_blank" class="stylish-link">
        Visit my E-Commerce Website
    </a>


</div>

