@{
    Layout = "_Layout";
}

<div class="pagestitlecontainer spad set-bg" data-setbg="/images/headergreen.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="pagestitletext">
                    <h2>CERTIFICATES</h2>
                    <div class="pagestitlebutton">
                        <a href="/Home/Index">Home</a>
                        <span>Certificates</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="portfolio spad">
    <div class="cert_div">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <ul class="certfilter">
                        <li class="active" data-filter="*">All</li>
                        <li data-filter=".web">Web</li>
                        <li data-filter=".game">Game</li>
                    </ul>
                </div>
            </div>

            <div class="row portfoliogal">
                <!-- Certificate 1 -->
                <div class="col-lg-4 col-md-6 col-sm-6 mix web">
                    <div class="portfolio__item">
                        <div class="portfolioitem set-bg" data-setbg="/images/cert/cert8.PNG"></div>
                        <div class="certificatetext">
                            <h4>Principles of Web Development and Introduction to HTML</h4>
                            <span>DICT Philippines</span>
                        </div>
                    </div>
                </div>

                <!-- Certificate 2 -->
                <div class="col-lg-4 col-md-6 col-sm-6 mix game">
                    <div class="portfolio__item">
