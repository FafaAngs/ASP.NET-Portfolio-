@{
    Layout = "_Layout";  // Assuming your layout file is named "_Layout.cshtml"
}

<div class="pagestitlecontainer spad set-bg" data-setbg="/images/headergreen.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="pagestitletext">
                    <h2>My Services</h2>
                    <div class="pagestitlebutton">
                        <a href="/Home/Index">Home</a>
                        <span>Services</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

