        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-6 col-sm-6">
                    <div class="servicescontent">
                        <div class="noborderspin">
                            <img src="/images/progPic/game-development.png" alt="">
                        </div>
                        <h4>Game Development</h4>
                        <p>I bring your game ideas to life with creativity, supporting you from start to finish.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-sm-6">
                    <div class="servicescontent">
                        <div class="noborderspin">
                            <img src="/images/progPic/html.png" alt="">
                        </div>
