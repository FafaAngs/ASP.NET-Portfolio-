@{
    Layout = null;

}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Angilbert Angcon's portfolio for software, web, and game development." />
    <title>@ViewData["Title"] | Angilbert Angcon</title>
    <link rel="icon" href="@Url.Content("~/images/aalogo.png")" type="image/png" />
    <link rel="stylesheet" href="@Url.Content("~/css/bootstrap.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/owl.carousel.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/slicknav.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/style.css")" />
</head>

<body>
    <div id="preloder">
        <div class="loader"></div>
    </div>

    <header class="header">
        <div class="container">
            <div class="row">
                <div class="col-lg-2">
                    <div class="headerLogo">
                        <a asp-controller="Home" asp-action="Index" aria-label="Angilbert Angcon home"><img src="~/images/aalogo.png" alt="Angilbert Angcon logo" /></a>
                    </div>
                </div>
                <div class="col-lg-10">
                    <div class="HeaderNavOption">
                        <nav class="HeaderNavMenu mobile-menu" aria-label="Primary navigation">
                            <ul>
                                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                                <li><a asp-controller="Home" asp-action="About">About</a></li>
                                <li><a asp-controller="Home" asp-action="Certificates">Certificates</a></li>
                                <li><a asp-controller="Home" asp-action="Services">Services</a></li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
            <div id="mobile-menu-wrap"></div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <script src="@Url.Content("~/js/jquery-3.3.1.min.js")"></script>
    <script src="@Url.Content("~/js/mixitup.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.slicknav.js")"></script>
    <script src="@Url.Content("~/js/owl.carousel.min.js")"></script>
    <script src="@Url.Content("~/js/connector.js")"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
